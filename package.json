{
  "name": "volunteer-attendance",
  "version": "0.1.0",
  "private": true,
  "description": "QR-based, session-oriented volunteer attendance system",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "migrate": "tsx src/server/scripts/migrate.ts",
    "migrate:prod": "node dist/server/scripts/migrate.js",
    "create-admin": "tsx src/server/scripts/create-admin.ts",
    "seed:demo": "tsx src/server/scripts/seed-demo.ts --demo",
    "demo": "tsx src/server/scripts/seed-demo.ts --demo --reset && concurrently -n api,web -c blue,magenta \"tsx watch src/server/index.ts --demo\" \"vite --host\"",
    "demo:start": "npm run build && node dist/server/scripts/seed-demo.js --demo --reset && node dist/server/index.js --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "luxon": "3.5.0",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/luxon": "3.4.2",
    "@types/node": "20.17.10",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
