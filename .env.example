# --- Required in production -------------------------------------------------
# PostgreSQL connection string. If unset (dev only), an embedded PGlite
# database is stored in ./.data/pglite.
DATABASE_URL=postgres://attendance:change-me@localhost:5432/attendance

# Secret used to sign session cookies (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# Public origin used when encoding venue QR codes. Must be the HTTPS URL
# volunteers will open, e.g. https://attendance.example.org
PUBLIC_BASE_URL=http://localhost:5173

# --- Optional ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Redirect plain HTTP to HTTPS (honours X-Forwarded-Proto behind a proxy).
FORCE_HTTPS=false
# Number of reverse-proxy hops to trust for client IPs / protocol (0 = none).
TRUST_PROXY=0
# Default timezone for new venues and for date-range filters.
DEFAULT_TIMEZONE=Asia/Singapore
# Default check-in window relative to scheduled start (minutes).
CHECKIN_OPENS_BEFORE_MINUTES=15
CHECKIN_CLOSES_AFTER_MINUTES=60
# When an admin reopens a session whose window has passed, extend it by this much.
REOPEN_EXTENSION_MINUTES=60
# Automatically mark sessions CLOSED once their check-in window ends.
AUTO_CLOSE_SESSIONS=true
# How often the session scheduler runs (seconds).
SCHEDULER_INTERVAL_SECONDS=30
# Session cookie lifetime (hours).
SESSION_TTL_HOURS=720

# --- Event access (passes & email) -------------------------------------------
# 32-byte key (base64) used to encrypt pass tokens at rest so passes can be
# reprinted/re-emailed. REQUIRED in production; rotating it invalidates reprints
# (existing passes still scan, because scans use a SHA-256 hash). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# SMTP for pass and verification-code emails. Unset in development = log only.
SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM="Event Access <no-reply@example.org>"
# Maximum participant import file size (bytes).
IMPORT_MAX_BYTES=5242880

# --- Demo / hosting ------------------------------------------------------------
# Demo data + /demo guide (loads automatically on first start).
DEMO_MODE=false
# Required to run DEMO_MODE with NODE_ENV=production (demo-only deployments).
ALLOW_DEMO_IN_PRODUCTION=false
# Migrations run on startup; set false if you run `npm run migrate:prod` separately.
MIGRATE_ON_START=true
# On Render, PUBLIC_BASE_URL defaults to RENDER_EXTERNAL_URL and TRUST_PROXY to 1.
